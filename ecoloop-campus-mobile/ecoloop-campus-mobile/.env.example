# ==========================================
# CẤU HÌNH SUPABASE (DỮ LIỆU & XÁC THỰC)
# ==========================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ==========================================
# CẤU HÌNH AI
# ==========================================
# Expo Go/Android Studio Emulator gọi backend trên máy host qua 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# remote: dùng FastAPI /predict ổn định cho Expo Go.
# local-first: thử on-device AI trước, nếu chưa có native TFLite runtime thì fallback FastAPI.
EXPO_PUBLIC_AI_MODE=remote

# ==========================================
# TÀI KHOẢN TEST (DÙNG ĐỂ ĐIỀN NHANH)
# ==========================================
EXPO_PUBLIC_TEST_STUDENT_EMAIL=student@school.edu.vn
EXPO_PUBLIC_TEST_STUDENT_PASSWORD=change-me
EXPO_PUBLIC_TEST_VOLUNTEER_EMAIL=volunteer@school.edu.vn
EXPO_PUBLIC_TEST_VOLUNTEER_PASSWORD=change-me
EXPO_PUBLIC_SMOKE_WRITE=0
